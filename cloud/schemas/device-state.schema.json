{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mincontrol.local/cloud/device-state.schema.json",
  "title": "DeviceState (API.md section 2; cloud-local until protocol ships a schema)",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts", "agentVersion", "users"],
  "properties": {
    "ts": { "$ref": "https://mincontrol.local/protocol/common.schema.json#/$defs/timestamp" },
    "agentVersion": { "type": "string", "maxLength": 32 },
    "policyVersion": { "type": ["integer", "null"], "minimum": 0 },
    "users": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sid"],
        "properties": {
          "sid": { "$ref": "https://mincontrol.local/protocol/common.schema.json#/$defs/sid" },
          "loggedOn": { "type": "boolean" },
          "active": { "type": "boolean" },
          "locked": { "type": "boolean" },
          "lockedUntil": {
            "anyOf": [{ "$ref": "https://mincontrol.local/protocol/common.schema.json#/$defs/timestamp" }, { "type": "null" }]
          },
          "remainingMin": { "type": ["integer", "null"] },
          "usedMin": { "type": ["integer", "null"], "minimum": 0 },
          "groups": {
            "type": "object",
            "maxProperties": 64,
            "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "usedMin": { "type": ["integer", "null"] }, "remainingMin": { "type": ["integer", "null"] } }
            }
          },
          "foregroundExe": { "type": ["string", "null"], "maxLength": 260 },
          "foregroundTitle": { "type": ["string", "null"], "maxLength": 512 }
        }
      }
    }
  }
}
