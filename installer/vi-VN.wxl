<?xml version="1.0" encoding="utf-8"?>
<!--
  Vietnamese UI strings. Database codepage 1258 (Windows Vietnamese). Write the text normally (precomposed UTF-8);
  scripts/build-msi.ps1 converts it to the cp1258 form (base letter + combining tone mark) before WiX reads it.
  Strings not listed here fall back to WixToolset.UI.wixext en-US (culture chain vi-VN,en-US).
-->
<WixLocalization Culture="vi-VN" Codepage="1258" Language="1066" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <!-- buttons -->
  <String Id="WixUIBack" Value="&amp;Quay lại" />
  <String Id="WixUINext" Value="&amp;Tiếp" />
