<?xml version="1.0" encoding="utf-8"?>
<!--
  MinControl agent MSI (SPEC §8.1, §8.7, §8.8, M7).

  Installs the self-contained win-x64 publish output of MinControl.Service, .Session, .NativeHost and .Setup
  into %ProgramFiles%\MinControl (all four apps share one folder: Session must sit next to Service, the native
  host path is pinned by the pipe server). Folder ACL: SYSTEM + Administrators full, Users read/execute only.

  Public properties (all optional):
    SERVERURL=https://…           runs "MinControl.Setup install" after the files/service are in place
    CHROMEEXTID=<32 a-p>  EDGEEXTID=<32 a-p>   extension store ids written to %ProgramData%\MinControl\config.json
    PURGE=1                       on uninstall also wipe %ProgramData%\MinControl (identity, state, logs)

  Uninstall runs "MinControl.Setup uninstall" (from-msi mode) first (stop service, remove WFP filters, browser
  policies for every profile, native host registration, SafeBoot keys) so the managed user is never left
  without internet (persistent WFP filters, I4).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="MinControl"
           Manufacturer="MinControl"
           Version="$(var.ProductVersion)"
           UpgradeCode="0FF6131D-7548-474C-A7F7-10D83D1265D9"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <MajorUpgrade DowngradeErrorMessage="A newer version of MinControl is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Admin only: per-machine package, elevated install required, x64 Windows 10/11 only. -->
    <Property Id="MSIUSEREALADMINDETECTION" Value="1" />
    <Launch Condition="Privileged" Message="MinControl must be installed by an administrator." />
    <Launch Condition="VersionNT64" Message="MinControl requires 64-bit Windows." />
    <Launch Condition="Installed OR VersionNT >= 603" Message="MinControl requires Windows 10 or later." />

    <!-- Programs and Features: removable (by an administrator only: per-machine product), no "Change". -->
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCOMMENTS" Value="Parental control agent. Removing it requires an administrator." />

    <Property Id="SERVERURL" Secure="yes" />
    <Property Id="CHROMEEXTID" Secure="yes" />
    <Property Id="EDGEEXTID" Secure="yes" />
    <Property Id="PURGE" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MinControl" />
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="MinControl" />
    </StandardDirectory>

    <Feature Id="Agent" Title="MinControl agent" AllowAbsent="no">
      <ComponentGroupRef Id="AgentFiles" />
      <ComponentRef Id="InstallFolderAcl" />
      <ComponentRef Id="DataFolderAcl" />
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="SetupComponent" />
      <ComponentRef Id="SafeBootRegistration" />
      <ComponentRef Id="NativeHostRegistration" />
    </Feature>

    <!-- ============================================================ files -->

    <ComponentGroup Id="AgentFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\MinControl.Service.exe" />
        <Exclude Files="$(var.PublishDir)\MinControl.Setup.exe" />
        <!-- placeholder manifest from the NativeHost project; the real one is generated by Setup/Service -->
        <Exclude Files="$(var.PublishDir)\com.mincontrol.nativehost.json" />
        <Exclude Files="$(var.PublishDir)\**\*.pdb" />
      </Files>
    </ComponentGroup>

    <!-- SYSTEM + Administrators: full; Users: read & execute (browsers launch the native host as the user). -->
    <Component Id="InstallFolderAcl" Directory="INSTALLFOLDER" Guid="C8484D18-77BE-4A14-BB09-4F81DD72ABEA">
      <CreateFolder>
        <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
      </CreateFolder>
    </Component>

    <!-- %ProgramData%\MinControl: SYSTEM + Administrators only (I7). Permanent: state survives uninstall
         unless PURGE=1 (Setup deletes it). -->
    <Component Id="DataFolderAcl" Directory="DATAFOLDER" Guid="55CF5B65-98B9-41A4-9EE5-8B9356E0793B" Permanent="yes">
      <CreateFolder>
        <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
      </CreateFolder>
    </Component>

    <!-- ============================================================ service (SPEC 8.1) -->

    <Component Id="ServiceComponent" Directory="INSTALLFOLDER">
      <File Id="ServiceExe" Source="$(var.PublishDir)\MinControl.Service.exe" KeyPath="yes" />
      <ServiceInstall Id="MinControlService"
                      Name="MinControl"
                      DisplayName="MinControl"
                      Description="MinControl parental control agent"
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="LocalSystem"
                      Vital="yes">
        <!-- recovery (SPEC 8.1): restart after 0 s on 1st / 2nd / subsequent failures, counter reset after 1 day.
             util:ServiceConfig instead of the MSI 5 MsiServiceConfig* tables (documented as unreliable). -->
        <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                            ThirdFailureActionType="restart" RestartServiceDelayInSeconds="0" ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="MinControlServiceStop" Name="MinControl" Stop="both" Remove="uninstall" Wait="yes" />
      <!-- start without waiting: an unenrolled agent idles, a failing start must not roll back the install -->
      <ServiceControl Id="MinControlServiceStart" Name="MinControl" Start="install" Wait="no" />
    </Component>

    <Component Id="SetupComponent" Directory="INSTALLFOLDER">
      <File Id="SetupExe" Source="$(var.PublishDir)\MinControl.Setup.exe" KeyPath="yes" />
    </Component>

    <!-- ============================================================ registry -->

    <!-- Safe Mode (minimal + networking) starts the service too (SPEC 8.1 / 8.8). -->
    <Component Id="SafeBootRegistration" Directory="INSTALLFOLDER" Bitness="always64"
               Guid="90C83512-EFF2-48E9-8EC8-82434365B2F2">
      <RegistryValue Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\SafeBoot\Minimal\MinControl"
                     Type="string" Value="Service" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\SafeBoot\Network\MinControl"
                     Type="string" Value="Service" />
    </Component>

    <!-- Native messaging host for Chrome + Edge (HKLM, so the managed user cannot redirect it).
         The manifest itself carries the extension ids and is written by Setup/Service. -->
    <Component Id="NativeHostRegistration" Directory="INSTALLFOLDER" Bitness="always64"
               Guid="577F5A0F-0DB6-462F-A6DB-4884F5964DC1">
      <RegistryValue Root="HKLM" Key="SOFTWARE\Google\Chrome\NativeMessagingHosts\com.mincontrol.nativehost"
                     Type="string" Value="[INSTALLFOLDER]com.mincontrol.nativehost.json" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Edge\NativeMessagingHosts\com.mincontrol.nativehost"
                     Type="string" Value="[INSTALLFOLDER]com.mincontrol.nativehost.json" />
      <RemoveFile Id="RemoveNativeHostManifest" Name="com.mincontrol.nativehost.json" On="uninstall" />
    </Component>

    <!-- ============================================================ custom actions (MinControl.Setup) -->

    <!-- install: post-MSI config (only when SERVERURL is given; otherwise run Setup install by hand) -->
    <SetProperty Id="CA_SetupInstall" Sequence="execute" Before="CA_SetupInstall"
                 Value="&quot;[#SetupExe]&quot; install --from-msi --server &quot;[SERVERURL]&quot; --chrome-ext &quot;[CHROMEEXTID]&quot; --edge-ext &quot;[EDGEEXTID]&quot;" />
    <CustomAction Id="CA_SetupInstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />

    <!-- failure actions also on non-crash stops (exit with error) + unrestricted service SID: not expressible
         with util:ServiceConfig, so sc.exe runs after InstallServices. Start type stays "auto" (not delayed). -->
    <SetProperty Id="CA_ScFailureFlag" Sequence="execute" Before="CA_ScFailureFlag"
                 Value="&quot;[System64Folder]sc.exe&quot; failureflag MinControl 1" />
    <CustomAction Id="CA_ScFailureFlag" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />
    <SetProperty Id="CA_ScSidType" Sequence="execute" Before="CA_ScSidType"
                 Value="&quot;[System64Folder]sc.exe&quot; sidtype MinControl unrestricted" />
    <CustomAction Id="CA_ScSidType" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />

    <!-- uninstall cleanup; never blocks removal (Return=ignore), output goes to the MSI log -->
    <SetProperty Id="PURGEARG" Value="--purge" After="InstallInitialize" Sequence="execute" Condition="PURGE = &quot;1&quot;" />
    <SetProperty Id="CA_SetupUninstall" Sequence="execute" Before="CA_SetupUninstall"
                 Value="&quot;[#SetupExe]&quot; uninstall --yes --from-msi [PURGEARG]" />
    <CustomAction Id="CA_SetupUninstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="CA_SetupUninstall" After="StopServices"
              Condition="REMOVE ~= &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="CA_ScFailureFlag" After="InstallServices" Condition="NOT REMOVE" />
      <Custom Action="CA_ScSidType" After="CA_ScFailureFlag" Condition="NOT REMOVE" />
      <Custom Action="CA_SetupInstall" After="CA_ScSidType"
              Condition="NOT REMOVE AND SERVERURL" />
    </InstallExecuteSequence>
  </Package>
</Wix>
