{
  "manifest_version": 3,
  "name": "MinControl",
  "short_name": "MinControl",
  "version": "0.1.0",
  "description": "Family safety companion for MinControl: applies the web rules set by parents on this PC.",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": [
    "tabs",
    "webNavigation",
    "downloads",
    "nativeMessaging",
    "declarativeNetRequest",
    "storage",
    "alarms"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "incognito": "not_allowed"
}
