{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mincontrol.local/protocol/app-groups.schema.json",
  "title": "Default app groups (app-groups.json)",
  "description": "API.md section 19. Default groups of apps a newly managed user gets (no quota); the parent turns limits on per group.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "groups"],
  "properties": {
    "version": { "type": "integer", "minimum": 1, "description": "bump on every content change" },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "description", "match"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 60, "description": "Vietnamese" },
          "description": { "type": "string", "minLength": 1, "maxLength": 300, "description": "Vietnamese" },
          "match": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/appMatch" } }
        }
      }
    }
  }
}
