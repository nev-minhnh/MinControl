{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mincontrol.local/protocol/search-engines.schema.json",
  "title": "Web search engines blocked by SafeSearch (search-engines.json)",
  "description": "API.md section 19. Every engine other than Google and Bing is blocked while web.safeSearch is on. Must never list google/bing/youtube/msn/microsoft hosts (checked by tools/validate.mjs).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "engines"],
  "properties": {
    "version": { "type": "integer", "minimum": 1, "description": "bump on every content change" },
    "engines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "domains"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{2,32}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "domains": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/domainPattern" } }
        }
      }
    }
  }
}
