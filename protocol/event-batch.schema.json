{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mincontrol.local/protocol/event-batch.schema.json",
  "title": "Event batch upload (device → cloud)",
  "type": "object",
  "additionalProperties": false,
  "required": ["deviceId", "sentAt", "events"],
  "properties": {
    "deviceId": { "$ref": "common.schema.json#/$defs/ulid" },
    "sentAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "events": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "event.schema.json" } }
  }
}
