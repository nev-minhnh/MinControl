{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mincontrol.local/protocol/services.schema.json",
  "title": "Service catalog (services.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "services"],
  "properties": {
    "version": { "type": "integer", "minimum": 1, "description": "bump on every content change" },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "domains", "apps"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{2,32}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "category": { "enum": ["video", "social", "games", "chat", "music", "ai", "other"] },
          "domains": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/domainPattern" } },
          "apps": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/appMatch" } }
        }
      }
    }
  }
}
