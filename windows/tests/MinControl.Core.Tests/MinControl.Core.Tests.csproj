    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);SESSION_LOGIC_LINKED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="JsonSchema.Net" />
    <ProjectReference Include="..\..\src\MinControl.Core\MinControl.Core.csproj" />
    <ProjectReference Include="..\..\src\MinControl.Monitoring\MinControl.Monitoring.csproj" />
    <ProjectReference Include="..\..\src\MinControl.NetGuard\MinControl.NetGuard.csproj" />
    <ProjectReference Include="..\..\src\MinControl.Browser\MinControl.Browser.csproj" />
    <Compile Include="..\..\src\MinControl.Service\Logic\*.cs" LinkBase="SessionLogic" />
  </ItemGroup>
</Project>
