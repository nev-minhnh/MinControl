<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="NSec.Cryptography" />
    <PackageReference Include="Sodium.Core" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- protocol/*.schema.json are the source of truth; embedded so the device validates bodies offline -->
    <EmbeddedResource Include="..\..\..\protocol\*.schema.json" LogicalName="MinControl.Schemas.%(Filename)%(Extension)" />
    <!-- API.md §17 service catalog, read at build time; a YouTube-only placeholder until protocol/services.json exists -->
    <EmbeddedResource Include="..\..\..\protocol\services.json" LogicalName="MinControl.Services.json" Condition="Exists('..\..\..\protocol\services.json')" />
    <EmbeddedResource Include="Catalog\services.placeholder.json" LogicalName="MinControl.Services.json" Condition="!Exists('..\..\..\protocol\services.json')" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MinControl.Core.Tests" />
  </ItemGroup>
</Project>
