<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MinControl.Service</RootNamespace>
    <!-- MERGED: all streams merged (real AddMinControlCore + Monitoring/NetGuard/Browser). Build with -p:MERGED=true. -->
    <DefineConstants Condition="'$(MERGED)' == 'true'">$(DefineConstants);MERGED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <ProjectReference Include="..\MinControl.Core\MinControl.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(MERGED)' == 'true'">
    <ProjectReference Include="..\MinControl.Monitoring\MinControl.Monitoring.csproj" />
    <ProjectReference Include="..\MinControl.NetGuard\MinControl.NetGuard.csproj" />
    <ProjectReference Include="..\MinControl.Browser\MinControl.Browser.csproj" />
  </ItemGroup>
</Project>
